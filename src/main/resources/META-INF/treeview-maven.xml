<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">

        <projectViewPane implementation="ir.farsroidx.maven.MavenProjectViewPane"/>

    </extensions>

    <actions>

        <action
            id="ir.farsroidx.maven.SyncSourceRoots"
            class="ir.farsroidx.maven.actions.SetupSourceRootsAction"
            text="Sync Project Source Roots"
            description="Configures missing conventional Maven source and resource roots.">

            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="WeighingNewGroup"/>

        </action>

    </actions>

</idea-plugin>
